SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,web

# PostgreSQL — host is the docker-compose service name
DB_NAME=beautybook_db
DB_USER=beautybook_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Redis / Celery — host is the docker-compose service name
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Payment provider — set to "lenco" when ready for live payments
PAYMENT_PROVIDER=mock

# Lenco (required when PAYMENT_PROVIDER=lenco)
LENCO_API_KEY=
LENCO_ACCOUNT_NO=

# MTN MoMo / Airtel Money (for future direct mobile money integration)
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# OpenAI — powers the booking, scheduling, payment, and insights agents
OPENAI_API_KEY=sk-proj-...
