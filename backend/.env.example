SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,web

# PostgreSQL — host is the docker-compose service name
DB_NAME=beautybook_db
DB_USER=beautybook_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Redis / Celery — host is the docker-compose service name
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Payment provider — set to "lipila" when ready for live mobile money payments
PAYMENT_PROVIDER=mock

# Lipila (required when PAYMENT_PROVIDER=lipila)
LIPILA_API_KEY=
LIPILA_ENV=sandbox
LIPILA_BASE_URL=
LIPILA_CALLBACK_URL=
LIPILA_WEBHOOK_SECRET=

# n8n — outgoing webhook that sends booking events to WhatsApp
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# Cloudflare Turnstile — bot protection on the signup form
TURNSTILE_SECRET_KEY=

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel — auto-provisions a subdomain for each tenant on signup
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# OpenAI — powers the booking, scheduling, payment, and insights agents
OPENAI_API_KEY=sk-proj-...
